<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1">
    <name>TINY</name>
    <description>
        A chip that does not exist, holding one of everything this tool
        understands.
    </description>
    <width>32</width>
    <size>32</size>
    <access>read-write</access>
    <peripherals>
        <peripheral>
            <name>UART0</name>
            <baseAddress>0x40070000</baseAddress>
            <description>A serial port</description>
            <registers>
                <register>
                    <name>CTRL</name>
                    <addressOffset>0x00000000</addressOffset>
                    <description>Control</description>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>ENABLE</name>
                            <description>Turns the port on</description>
                            <bitRange>[0:0]</bitRange>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PARITY</name>
                            <bitRange>[3:2]</bitRange>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>NONE</name>
                                    <description>No parity bit</description>
                                    <value>0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>EVEN</name>
                                    <value>1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>odd_parity</name>
                                    <value>2</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>DATA</name>
                    <addressOffset>0x00000004</addressOffset>
                    <fields>
                        <field>
                            <name>BYTE</name>
                            <bitOffset>0</bitOffset>
                            <bitWidth>8</bitWidth>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
        <peripheral derivedFrom="UART0">
            <name>UART1</name>
            <baseAddress>0x40078000</baseAddress>
            <description>A second serial port</description>
        </peripheral>
        <peripheral>
            <name>WIDE</name>
            <baseAddress>0x50000000</baseAddress>
            <registers>
                <register>
                    <name>ALL</name>
                    <addressOffset>0</addressOffset>
                    <fields>
                        <field>
                            <name>EVERY</name>
                            <lsb>0</lsb>
                            <msb>31</msb>
                        </field>
                    </fields>
                </register>
            </registers>
        </peripheral>
    </peripherals>
</device>
